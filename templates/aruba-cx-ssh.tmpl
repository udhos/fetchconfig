# aruba-cx-ssh.tmpl - Aruba CX (AOS-CX) over SSH.
#
# syntax_style: aruba-cx
#
# Derived from fetchconfig::model::ArubaCXSSH. SSH lands authenticated at the
# admin "#" prompt (no enable). prompt_settle_ms lets the login banner finish
# before the prompt is matched (the model drains to idle first). NOTE: a
# hostname containing spaces/Unicode (e.g. "sw01 UG Buero#") is only partially
# learned by the generic prompt matcher - adjust prompt_tail if needed.
# Note: DRAFT - please verify on real hardware.

transport        ssh
banner_timeout   30
fetch_timeout    120
max_visits       8
prompt_settle_ms 150

prompt_head      ''
prompt_tail      '# ?$'

# show "show running-config"; override per device with show_cmd=.
show_cmd         'show running-config'

# config begins at the first "!" line (drops "Current configuration:" preamble)
capture_from     /^!/

# ---- SSH entry: authenticated; at the admin prompt, disable paging ----
state state_login_ssh
    expect prompt  -> send "no page"   -> goto show

state show
    expect prompt  -> send show_cmd    -> goto capture

state capture
    capture_start
    expect prompt  -> capture_stop     -> goto logout

state logout
    send "exit" -> done
