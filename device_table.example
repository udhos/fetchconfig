# DEFAULT OPTIONS SECTION
#
#		model		options
#

# Optional: end-of-run backup summary e-mail (independent of any
# model). "user"/"password" are optional -- SMTP AUTH LOGIN is only
# attempted when both are given. "smtp" accepts host or host:port
# (default port 25, plain SMTP, no encryption). May be repeated;
# later values overwrite earlier ones for the same key.
#
# The recipient given here ("to=") always gets the status of every
# device backed up this run. A device can be assigned to a different
# recipient with the device-specific "to=" option (see the DEVICES
# SECTION below); that recipient then gets a separate e-mail limited
# to just their own device(s).
#
#email:		from=config.backup@acme.com,to=admin@acme.com,smtp=mail.acme.com
#email:		from=config.backup@acme.com,to=admin@acme.com,smtp=mail.acme.com,user=svc-fetchconfig,password=xxx
# footer= sets the mail footer's copyright text (" - Version <n>" is
# always appended). Quote the value if it contains a comma; the quotes
# are stripped.
#email:		footer="(c) 2006-2026 Everton da Silva Marques, Rainer Tammer and others"

default:	cisco-ios	user=backup,pass=fran,enable=jose
default:	cisco-ios	timeout=10,keep=5,changes_only=0
default:	cisco-ios	repository=/var/fetchconfig/save

default:	cisco-cat	user=backup,pass=fran,enable=jose
default:	cisco-cat	timeout=10,keep=5
default:	cisco-cat	changes_only=0,fetch_timeout=30
default:	cisco-cat	repository=/var/fetchconfig/save

default:        parks           user=admin,pass=parks
default:        parks           timeout=2,keep=5
default:        parks           fetch_timeout=30,banner_timeout=60
default:        parks           repository=/var/fetchconfig/save

default:        riverstone      user=rs3,pass=100,enable=adm
default:        riverstone      timeout=3,keep=3
default:        riverstone      fetch_timeout=30
default:        riverstone      repository=/var/fetchconfig/save

default:	terayon-os	user=testuser,pass=testpassword,enable=testenable
default:	terayon-os	timeout=60,keep=50,changes_only=0
default:	terayon-os	repository=/var/fetchconfig/save

default:        dmswitch        user=dm,pass=dmpass
default:        dmswitch        timeout=10,keep=5,changes_only=0
default:        dmswitch        repository=/var/fetchconfig/save

default:	cisco-asa	timeout=10,keep=5,changes_only=1
default:	cisco-asa	repository=/srv/fetchconfig

default:        3com-msr        user=admin,pass=lab,enable=lab
default:        3com-msr        timeout=10,keep=5,changes_only=0
default:        3com-msr        repository=/var/fetchconfig/save

default:        mikrotik        user=admin,pass=
default:        mikrotik        timeout=10,keep=5,changes_only=0
default:        mikrotik        repository=/var/fetchconfig/save

default:	cisco-pix	timeout=10,keep=5,changes_only=1
default:	cisco-pix	repository=/var/fetchconfig/save

default:        tellabs-msr     user=usr,pass=pwd,enable=jose
default:        tellabs-msr     timeout=10,keep=5,changes_only=0
default:        tellabs-msr     fetch_timeout=1200
default:        tellabs-msr     repository=/var/fetchconfig/save
default:	tellabs-msr	filename_append_suffix=.txt

default:	junos		user=juniper,pass=jun@321
default:	junos		timeout=10,keep=5,changes_only=0
default:	junos		filename_append_suffix=.txt
default:	junos		repository=/var/fetchconfig/save

default:	acme		user=admin,pass=acme
default:	acme		timeout=10,keep=5,changes_only=0
default:	acme		filename_append_suffix=.txt
default:	acme		repository=/var/fetchconfig/save

default:	mediant		user=Admin,pass=Admin
default:	mediant		timeout=10,keep=5,changes_only=0
default:	mediant		filename_append_suffix=.txt
default:	mediant		repository=/var/fetchconfig/save

default:        cisco-iosxr     user=backup,pass=fran
default:        cisco-iosxr     timeout=10,keep=5,changes_only=0
default:        cisco-iosxr     repository=/var/fetchconfig/save

default:	nec-univerge-ix	user=admin,pass=admin
default:	nec-univerge-ix	timeout=10,keep=5,changes_only=0
default:	nec-univerge-ix	filename_append_suffix=.txt
default:	nec-univerge-ix	repository=/var/fetchconfig/save

default:        coriant-8600    user=backup,pass=fran,enable=jose
default:        coriant-8600    timeout=10,keep=5,changes_only=0
default:        coriant-8600    repository=/var/fetchconfig/save

default:	procurve	user=admin,pass=procurve,enable=procurve
default:	procurve	timeout=10,keep=5,changes_only=0
default:	procurve	fetch_timeout=60,banner_timeout=30
default:	procurve	repository=/var/fetchconfig/save
default:	procurve	debug=off

default:	procurve-ssh	user=admin,pass=procurve,enable=procurve
default:	procurve-ssh	timeout=10,keep=5,changes_only=0
default:	procurve-ssh	fetch_timeout=60
default:	procurve-ssh	repository=/var/fetchconfig/save
default:	procurve-ssh	debug=off

default:	hirschmann	user=admin,pass=fran
default:	hirschmann	timeout=10,keep=5,changes_only=0
default:	hirschmann	repository=/var/fetchconfig/save

default:	zyxel		user=admin,pass=fran
default:	zyxel		timeout=10,keep=5,changes_only=0
default:	zyxel		repository=/var/fetchconfig/save

# planet-ssh: PLANET managed switches over SSH. "enable" only matters
# if the account lands on the ">" prompt; it defaults to pass.
# Input is typed character by character (type_delay ms, default 100):
# the switch does not reliably accept a burst of input after a prompt.
default:	planet-ssh	user=admin,pass=fran
default:	planet-ssh	timeout=10,keep=5,changes_only=0
default:	planet-ssh	type_delay=100
default:	planet-ssh	repository=/var/fetchconfig/save
default:	planet-ssh	debug=off

# aruba-cx-ssh: Aruba CX (AOS-CX) switches over SSH. The account must be
# an administrator ("#" prompt); AOS-CX has no "enable".
default:	aruba-cx-ssh	user=admin,pass=fran
default:	aruba-cx-ssh	timeout=10,keep=5,changes_only=0
default:	aruba-cx-ssh	repository=/var/fetchconfig/save
default:	aruba-cx-ssh	debug=off

# nexus-ssh: Cisco Nexus (NX-OS) over SSH. The account must land on the
# "#" prompt; NX-OS has no "enable".
default:	nexus-ssh	user=admin,pass=fran
default:	nexus-ssh	timeout=10,keep=5,changes_only=0
default:	nexus-ssh	repository=/var/fetchconfig/save
default:	nexus-ssh	debug=off

# mediant-sbc: AudioCodes Mediant SBC / gateway (current Cisco-style CLI).
# SSH by default; transport=telnet or transport=auto (SSH, telnet only if
# no SSH service answers). The enable password is mandatory. The default
# command "show running-config" gives the restore-ready (non-default)
# configuration; a second entry with show_cmd="show running-config full"
# keeps the audit form (all parameters incl. defaults) as well.
default:	mediant-sbc	user=Admin,pass=fran,enable=fran
default:	mediant-sbc	timeout=30,fetch_timeout=300,keep=5,changes_only=0
default:	mediant-sbc	repository=/var/fetchconfig/save
default:	mediant-sbc	transport=ssh,debug=off

# procurve-snmp: ProCurve ProVision (incl. 4000M/8000M) over SNMP+TFTP.
# community is the SNMP read-WRITE community (no user/pass). remote_file
# defaults to "browse" (readable report); later models also support
# "running-config". timeout defaults to 30s.
default:	procurve-snmp	community=private
default:	procurve-snmp	timeout=30,keep=5,changes_only=0
default:	procurve-snmp	remote_file=browse
default:	procurve-snmp	repository=/var/fetchconfig/save
default:	procurve-snmp	debug=off

# tplink-web-sg105e talks HTTP to the web UI of TP-Link Easy Smart
# switches (TL-SG105E, TL-SG105PE, ... - they have no CLI); the backup
# is saved uuencoded, restore with "uudecode".
default:	tplink-web-sg105e	user=admin,pass=fran
default:	tplink-web-sg105e	timeout=10,keep=5,changes_only=0
default:	tplink-web-sg105e	fetch_timeout=120
default:	tplink-web-sg105e	repository=/var/fetchconfig/save
default:	tplink-web-sg105e	debug=off

# procurve-web-1700 talks HTTP to the web UI of HP ProCurve 1700 series
# switches (web-managed only, no CLI). Only the manager password is
# needed; the backup is saved uuencoded, restore with "uudecode".
default:	procurve-web-1700	pass=fran
default:	procurve-web-1700	timeout=10,keep=5,changes_only=0
default:	procurve-web-1700	fetch_timeout=120
default:	procurve-web-1700	repository=/var/fetchconfig/save
default:	procurve-web-1700	debug=off


# Many devices? Fetch them concurrently: fetchconfig.pl -devices=... -P 20
# (see README, PARALLEL FETCHING). The device table itself needs no change.

# DEVICES SECTION
#
# model		dev-unique-id	hostname	device-specific-options
#
cisco-ios	inet-gw		10.0.0.1
cisco-ios	vpn-gw		192.168.0.1	keep=10,changes_only=1
cisco-ios	ancient-ios	192.168.0.3	show_cmd=wrterm

cisco-cat	sales-sw	172.16.0.10
cisco-cat	eng-sw		172.16.0.11	keep=10,changes_only=1

