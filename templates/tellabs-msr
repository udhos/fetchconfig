Template source
===============

Full source of templates/tellabs-msr.tmpl:

    # tellabs-msr.tmpl - Tellabs MSR over telnet.
    #
    # syntax_style: cisco-ios
    #
    # Derived from fetchconfig::model::TellabsMSR. "enable config" enters the
    # privileged/config context; the pager is disabled with a combined command.
    # Note: DRAFT - please verify on real hardware.
    
    transport      telnet
    banner_timeout 30
    fetch_timeout  120
    max_visits     8
    
    # show "show run"; override with show_cmd= (show_cmd=wrterm -> "write term").
    show_cmd       'show run'
    
    # drop the echoed "show run" command line
    skip_first     1
    
    prompt_head    ''
    prompt_tail    '# $'
    
    # ---- telnet entry: interactive login ----
    state state_login_telnet
        expect /Login: $/    -> send user        -> goto pw
        expect /Password: $/ -> send_secret pass   -> goto after_login
    
    state pw
        expect /Password: $/ -> send_secret pass   -> goto after_login
    
    state after_login
        expect /(\S+)[>#] $/ -> send "enable config" -> goto enable
    
    state enable
        expect /Password: $/ -> send_secret enable -> goto pager
        expect prompt        -> send "enable config terminal length 0" -> goto show
    
    state pager
        expect prompt        -> send "enable config terminal length 0" -> goto show
    
    state show
        expect prompt        -> send show_cmd      -> goto capture
    
    state capture
        capture_start
        expect prompt        -> capture_stop       -> goto logout
    
    state logout
        send "exit" -> done

