cisco-ios	vpn-gw		1.1.1.3	keep=10,changes_only=1
cisco-ios	ancient-ios	1.1.1.4	show_cmd=wrterm

cisco-cat	sales-sw	1.1.1.5
cisco-cat	eng-sw		1.1.1.6	keep=10,changes_only=1

