# generic (template-driven). model=<name> is MANDATORY and selects
# templates/<name>.tmpl. transport picks ssh or telnet (from the option
# here, else the template's first-listed transport). A device-table
# option overrides the same-named template value (e.g. banner_timeout).
generic		gen-rtr01	1.1.1.18	model=cisco-ios,transport=telnet
generic		gen-rtr02	1.1.1.19	model=cisco-ios,transport=ssh,user=svc,pass=secret
# (model=procurve shown for illustration; only templates/cisco-ios.tmpl
#  ships in 9.63 - a fetch with a missing template fails with a clear error)
generic		gen-sw01	1.1.1.20	model=procurve,transport=ssh,banner_timeout=60

