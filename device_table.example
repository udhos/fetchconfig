# "debug=off" from the default: block above suppresses the
# <dev_id>.debug session log; override it per-device (e.g. while
# troubleshooting a login/prompt problem) with debug=on.
procurve	sw-lab1		1.1.1.32

procurve-ssh	sw-lab2		1.1.1.33	debug=on

# "to=" overrides, for this device only, who receives the backup
# summary e-mail (see the "email:" line in the DEFAULT OPTIONS
# SECTION above). lab209r's backup summary goes to lab-owner@acme.com
# instead of the globally configured recipient (who still gets the
# status of every device, including this one).
parks           lab209r-2	1.1.1.34	to=lab-owner@acme.com

# "comment=" is a free-text note, purely for whoever reads this file
# (not used anywhere else). Quoting is only needed here because the
# comment itself contains a comma; without quotes, that comma would
# be read as the start of a new option.
riverstone	lab3101		1.1.1.35	comment="Building 3, Floor 2"

# "site=" is a free-text site/location tag, like comment= (fetchconfig does
# not use it). fetchconfig-web uses it for per-site access control; a device
# with no site= is visible only to "all sites" (site 0) users. Single-byte
# characters; quote the value if it contains a comma.
riverstone	lab3102		1.1.1.36	site="Plant 3, Hall A",comment="core switch"
