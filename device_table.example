mediant-sbc	sbc01		172.29.200.170
mediant-sbc	sbc01-full	172.29.200.170	show_cmd="show running-config full"

procurve-snmp	hp4000-sw01	153.3.231.23

tplink-web-sg105e	tpl-sw01	172.29.200.120

procurve-web-1700	hp1700-sw01	172.29.200.130

